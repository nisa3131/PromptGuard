FROM node:22-alpine AS web
WORKDIR /web
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /srv
ENV PYTHONUNBUFFERED=1 PORT=7860
COPY ml/requirements.txt /tmp/ml-requirements.txt
RUN pip install --no-cache-dir -r /tmp/ml-requirements.txt 'fastapi>=0.115,<1' 'uvicorn>=0.30,<1'
COPY ml/train.py /srv/ml/train.py
RUN python /srv/ml/train.py
ENV PROMPTGUARD_MODEL_PATH=/srv/ml/models/promptguard_baseline.joblib PROMPTGUARD_DB=/tmp/promptguard/db.sqlite3
COPY backend/app /srv/app
COPY --from=web /web/dist /srv/static
COPY deploy/cloud_app.py /srv/cloud_app.py
RUN useradd -m -u 1000 demo && chown -R demo:demo /srv
USER demo
EXPOSE 7860
CMD ["sh", "-c", "uvicorn cloud_app:app --host 0.0.0.0 --port ${PORT:-7860}"]
